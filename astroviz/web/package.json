{
  "name": "astroviz-runtime",
  "version": "0.0.1",
  "private": true,
  "description": "Browser runtime for astroviz: container reader, kinematic frames, three.js viewer, web component",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=iife --global-name=astroviz --minify --target=es2020 --outfile=dist/astroviz.js",
    "build:dev": "esbuild src/index.ts --bundle --format=iife --global-name=astroviz --sourcemap=inline --target=es2020 --outfile=dist/astroviz.dev.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "three": "^0.180.0"
  }
}
